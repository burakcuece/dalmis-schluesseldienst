---
import FaqSection from '../components/FaqSection.astro';
import FinalCta from '../components/FinalCta.astro';
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import PricePromise from '../components/PricePromise.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getFaqs } from '../data/faq';
import { business } from '../data/site';
import { faqSchema, type Crumb } from '../lib/schema';

const crumbs: Crumb[] = [
  { label: 'Start', path: '' },
  { label: 'Preise', path: 'preise/' },
];

const entries = getFaqs(['kosten-tuer', 'preis-wann', 'bezahlung', 'serioes']);

const factors: { title: string; text: string }[] = [
  { title: 'Die Situation', text: 'Eine zugefallene Tür ist etwas anderes als eine abgeschlossene.' },
  { title: 'Schloss & Tür', text: 'Art und Zustand von Schloss, Zylinder und Tür bestimmen das Vorgehen.' },
  { title: 'Aufwand', text: 'Wie viel Zeit und welches Werkzeug der Einsatz voraussichtlich braucht.' },
  { title: 'Uhrzeit', text: `Außerhalb von ${business.hours.regular}, also im Notdienst, kann sich der Preis unterscheiden.` },
  { title: 'Material', text: 'Zum Beispiel, wenn ein neuer Schließzylinder eingesetzt wird.' },
];
---

<BaseLayout
  title={`Preise für Schlüsseldienst in ${business.city}: vorab abgestimmt`}
  description={`Was kostet ein Schlüsseldienst in ${business.city}? Bei ${business.shortName} werden Preis und Vorgehen vor Beginn besprochen. Diese Faktoren beeinflussen die Kosten.`}
  path="preise/"
  crumbs={crumbs}
  schema={[faqSchema(entries, 'preise/')]}
>
  <PageHero
    title="Preise: vorher besprochen"
    lead="Bei DALMIS hören Sie den voraussichtlichen Preis am Telefon, bevor wir losfahren. Erst dann entscheiden Sie, ob Sie den Auftrag erteilen."
    crumbs={crumbs}
  />

  <section class="section section-white">
    <div class="container">
      <div class="section-heading">
        <h2>Wovon der Preis abhängt</h2>
        <p>
          Jeder Einsatz ist anders. Deshalb fragen wir zuerst nach Ihrer Situation und nennen Ihnen dann einen Preis, statt vorab mit
          Lockangeboten zu werben. Diese Punkte fließen in die Einschätzung ein:
        </p>
      </div>
      <ul class="info-grid info-grid-3">
        {factors.map((factor) => (
          <li class="info-card">
            <h3>{factor.title}</h3>
            <p>{factor.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <PricePromise />

  <section class="section section-white">
    <div class="container split">
      <div class="prose">
        <h2>Woran Sie einen seriösen Schlüsseldienst erkennen</h2>
        <p>
          Wer ausgesperrt ist, steht unter Druck. Genau das nutzen unseriöse Anbieter aus. Mit diesen Punkten schützen Sie sich, egal
          welchen Schlüsseldienst Sie beauftragen:
        </p>
        <ul class="check-list">
          <li><Icon name="check" />Der Anbieter nennt einen Namen, einen Ansprechpartner und einen Firmensitz.</li>
          <li><Icon name="check" />Der Preis wird vor Beginn der Arbeiten genannt, nicht erst danach.</li>
          <li><Icon name="check" />Sie werden nicht gedrängt, unter Zeitdruck etwas zu unterschreiben.</li>
          <li><Icon name="check" />Sie erhalten eine Rechnung mit den ausgeführten Leistungen.</li>
        </ul>
      </div>
      <aside class="aside-card">
        <h2>Gut zu wissen</h2>
        <p>Kartenzahlung vor Ort ist nicht möglich. Wie Sie bezahlen können, besprechen wir bei der Anfrage, zusammen mit dem Preis.</p>
      </aside>
    </div>
  </section>

  <FaqSection entries={entries} title="Fragen zu den Preisen" intro="Was Sie zu Kosten und Preisabsprache wissen sollten." />
  <FinalCta />
</BaseLayout>
