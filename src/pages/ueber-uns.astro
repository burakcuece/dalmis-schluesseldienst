---
import FinalCta from '../components/FinalCta.astro';
import OwnerSection from '../components/OwnerSection.astro';
import PageHero from '../components/PageHero.astro';
import ServiceIndex from '../components/ServiceIndex.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { services } from '../data/services';
import { business } from '../data/site';
import type { Crumb } from '../lib/schema';

const crumbs: Crumb[] = [
  { label: 'Start', path: '' },
  { label: 'Über uns', path: 'ueber-uns/' },
];
---

<BaseLayout
  title={`Über uns: Schlüsseldienst aus ${business.city}`}
  description={`${business.shortName} ist ein mobiler Schlüsseldienst aus ${business.city} für Türöffnung, Autoöffnung, Schloss und Zylinder sowie Sicherheitstechnik.`}
  path="ueber-uns/"
  crumbs={crumbs}
>
  <PageHero
    title={`Mobiler Schlüsseldienst aus ${business.city}`}
    lead={`${business.shortName} steht für Schlüsseldienst und Sicherheitstechnik. ${business.slogan}`}
    crumbs={crumbs}
  />

  <OwnerSection showMoreLink={false} />

  <section class="section section-white">
    <div class="container">
      <div class="section-heading">
        <h2>Leistungen</h2>
      </div>
      <ServiceIndex services={services} />
    </div>
  </section>

  <FinalCta />
</BaseLayout>
