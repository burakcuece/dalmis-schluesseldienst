---
import FinalCta from '../components/FinalCta.astro';
import OwnerSection from '../components/OwnerSection.astro';
import PageHero from '../components/PageHero.astro';
import ServiceCard from '../components/ServiceCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { services } from '../data/services';
import { business } from '../data/site';
import type { Crumb } from '../lib/schema';

const crumbs: Crumb[] = [
  { label: 'Start', path: '' },
  { label: 'Über uns', path: 'ueber-uns/' },
];
---

<BaseLayout
  title={`Über uns: ${business.owner}, Schlüsseldienst aus ${business.city}`}
  description={`${business.shortName} ist ein inhabergeführter mobiler Schlüsseldienst aus ${business.city}. Bei Ihrer Anfrage sprechen Sie direkt mit ${business.owner}.`}
  path="ueber-uns/"
  crumbs={crumbs}
>
  <PageHero
    title={`Ein Betrieb aus ${business.city}, ein Ansprechpartner`}
    lead={`${business.shortName} steht für Schlüsseldienst und Sicherheitstechnik mit persönlichem Ansprechpartner. ${business.slogan}`}
    crumbs={crumbs}
  />

  <OwnerSection showMoreLink={false} />

  <section class="section section-white">
    <div class="container">
      <div class="section-heading">
        <h2>Leistungen</h2>
      </div>
      <div class="services-grid">
        {services.map((service) => <ServiceCard service={service} variant="compact" />)}
      </div>
    </div>
  </section>

  <FinalCta />
</BaseLayout>
