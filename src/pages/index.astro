---
import AreaSection from '../components/AreaSection.astro';
import ContactButtons from '../components/ContactButtons.astro';
import FaqSection from '../components/FaqSection.astro';
import FinalCta from '../components/FinalCta.astro';
import Icon from '../components/Icon.astro';
import OwnerSection from '../components/OwnerSection.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import QuickHelp from '../components/QuickHelp.astro';
import ServiceCard from '../components/ServiceCard.astro';
import TrustStrip from '../components/TrustStrip.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getFaqs } from '../data/faq';
import { services } from '../data/services';
import { business } from '../data/site';
import { faqSchema, serviceSchema } from '../lib/schema';
import { asset, url } from '../lib/url';

const homeFaqs = getFaqs(['orte', 'kosten-tuer', 'auto', 'angaben']);

// Sprungmarken der früheren einseitigen Website bleiben erhalten
const legacyIds: Record<string, string> = { tueroeffnung: 'tueroeffnung', autooeffnung: 'auto', sicherheitstechnik: 'sicherheitstechnik' };
---

<BaseLayout
  fullTitle={`Schlüsseldienst ${business.city} & Autoöffnung | ${business.shortName}`}
  title="Startseite"
  description={`${business.shortName}: mobiler Schlüsseldienst in ${business.city} und Umgebung für Türöffnung, Autoöffnung, Schlosswechsel und Sicherheitstechnik. Persönlich anrufen oder per WhatsApp anfragen.`}
  path=""
  schema={[
    serviceSchema(
      `Mobiler Schlüsseldienst ${business.city}`,
      'Mobiler Schlüsseldienst, Türöffnung, Autoöffnung, Schlosswechsel und Sicherheitstechnik',
      '',
    ),
    faqSchema(homeFaqs, ''),
  ]}
>
  <section class="hero" id="top">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Mobiler Schlüsseldienst aus {business.city}</p>
        <h1><span>Ausgesperrt?</span><strong>Wir kommen direkt zu Ihnen.</strong></h1>
        <p class="hero-lead">
          Ob Haustür, Fahrzeug oder Schloss: Bei {business.shortName} sprechen Sie direkt mit {business.owner}. Nennen Sie Ihren Standort und schildern Sie kurz, was passiert ist.
        </p>
        <ContactButtons class="hero-actions" />
        <p class="hero-proofline"><Icon name="check" /> Preis und Vorgehen werden vor Beginn abgestimmt.</p>
      </div>
      <div class="hero-visual">
        <img src={asset('door-lock.webp')} width="1400" height="933" alt="Türgriff und Schließzylinder an einer Haustür" fetchpriority="high" decoding="async" />
      </div>
    </div>
  </section>

  <TrustStrip />
  <QuickHelp />

  <section class="section section-white services-section" id="leistungen">
    <div class="container">
      <div class="section-heading">
        <h2>Leistungen</h2>
        <p>Vier Bereiche, ein Ansprechpartner. Fragen Sie direkt an, welche Lösung für Ihre Situation möglich ist.</p>
      </div>
      <div class="services-grid services-grid-4">
        {services.map((service) => <ServiceCard service={service} id={legacyIds[service.slug]} />)}
      </div>
      <p class="more-link"><a class="text-link" href={url('leistungen/')}>Alle Leistungen im Überblick</a></p>
    </div>
  </section>

  <ProcessSteps
    tone="light"
    title="So läuft ein Einsatz ab"
    steps={[
      { title: 'Anrufen oder schreiben', text: 'Per Telefon oder WhatsApp. Sagen Sie, wo Sie sind und was passiert ist.' },
      { title: 'Preis erfahren', text: 'Sie hören den voraussichtlichen Preis und das Vorgehen, bevor jemand losfährt.' },
      { title: 'Entscheiden', text: 'Erst mit Ihrer Zusage wird der Einsatz fest vereinbart.' },
      { title: 'Hilfe vor Ort', text: `${business.owner} kommt zu Ihnen und erledigt die Arbeit.` },
    ]}
  />
  <OwnerSection tone="white" />
  <AreaSection />
  <FaqSection entries={homeFaqs} />
  <FinalCta />
</BaseLayout>
