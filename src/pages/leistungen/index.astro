---
import FinalCta from '../../components/FinalCta.astro';
import PageHero from '../../components/PageHero.astro';
import PricePromise from '../../components/PricePromise.astro';
import ServiceIndex from '../../components/ServiceIndex.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { services } from '../../data/services';
import { business } from '../../data/site';
import type { Crumb } from '../../lib/schema';

const crumbs: Crumb[] = [
  { label: 'Start', path: '' },
  { label: 'Leistungen', path: 'leistungen/' },
];
---

<BaseLayout
  title={`Leistungen: Türöffnung, Autoöffnung, Schloss & Sicherheit in ${business.city}`}
  description={`Alle Leistungen von ${business.shortName} im Überblick: Türöffnung, Autoöffnung, Schlosswechsel, Schließzylinder und Sicherheitstechnik in ${business.city} und Umgebung.`}
  path="leistungen/"
  crumbs={crumbs}
>
  <PageHero
    title="Leistungen"
    lead={`Von der zugefallenen Tür bis zur Beratung für mehr Sicherheit: Bei ${business.shortName} bekommen Sie alles aus einer Hand.`}
    crumbs={crumbs}
  />

  <section class="section section-light services-section">
    <div class="container">
      <ServiceIndex services={services} />
    </div>
  </section>

  <PricePromise />
  <FinalCta />
</BaseLayout>
