---
import ContactButtons from '../../components/ContactButtons.astro';
import ProcessSteps from '../../components/ProcessSteps.astro';
import ServiceLayout from '../../layouts/ServiceLayout.astro';
import { business } from '../../data/site';
import { getService } from '../../data/services';

const service = getService('sicherheitstechnik');
---

<ServiceLayout
  slug="sicherheitstechnik"
  metaTitle={`Sicherheitstechnik für Türen in ${business.city}`}
  description={`Mehr Sicherheit an Ihrer Tür: ${business.shortName} berät in ${business.city} und Umgebung persönlich zu Schutzbeschlägen, Sicherheitszylindern und Zusatzsicherungen.`}
  heroTitle="Sicherheitstechnik für Ihre Tür"
  lead={'Welche Technik passt zu Ihrer Tür? Wir besprechen mit Ihnen, welche Lösungen in Frage kommen, persönlich und passend zu Ihrer Situation.'}
  faqIds={['sicherheit-passend', 'schloss-wann', 'ansprechpartner', 'preis-wann']}
  faqTitle="Fragen zur Sicherheitstechnik"
>
  <section class="section section-white">
    <div class="container">
      <div class="section-heading">
        <h2>Worauf es an der Tür ankommt</h2>
        <p>
          Schutz entsteht im Zusammenspiel von Tür, Rahmen, Schloss und Beschlag. Diese Bausteine sind häufig Thema der Beratung. Welche
          Lösung für Ihre Tür sinnvoll ist und was {business.shortName} konkret umsetzt, besprechen wir direkt mit Ihnen.
        </p>
      </div>
      <ul class="info-grid info-grid-3">
        <li class="info-card">
          <h3>Schutzbeschlag</h3>
          <p>Ein Schutzbeschlag deckt den Schließzylinder außen ab und erschwert es, ihn abzubrechen oder herauszuziehen.</p>
        </li>
        <li class="info-card">
          <h3>Sicherheitszylinder</h3>
          <p>Hochwertige Zylinder bieten zum Beispiel Schutz gegen Aufbohren, Ziehen oder Nachschließen.</p>
        </li>
        <li class="info-card">
          <h3>Zusatzsicherung</h3>
          <p>Zusatzschlösser oder Querriegel können die Tür an weiteren Punkten sichern, je nach Tür und Rahmen.</p>
        </li>
      </ul>
    </div>
  </section>

  <ProcessSteps
    tone="light"
    title="So läuft die Beratung ab"
    steps={[
      { title: 'Anfrage stellen', text: 'Anrufen, per WhatsApp oder per E-Mail schreiben.' },
      { title: 'Tür beschreiben', text: 'Art der Tür, vorhandenes Schloss, gern mit Fotos.' },
      { title: 'Lösung besprechen', text: 'Welche Technik passt? Was kostet sie voraussichtlich?' },
      { title: 'Umsetzung nach Absprache', text: 'Termin und Vorgehen werden gemeinsam abgestimmt.' },
    ]}
  />

  <section class="section section-white section-compact">
    <div class="container">
      <div class="aside-card">
        <h2>Beratung anfragen</h2>
        <p>
          Schicken Sie gern Fotos Ihrer Tür von innen und außen per WhatsApp. So lässt sich schon vorab besser einschätzen, welche Lösungen
          in Frage kommen.
        </p>
        <ContactButtons class="aside-actions aside-actions-inline" whatsappText={service.whatsappText} />
      </div>
    </div>
  </section>
</ServiceLayout>
