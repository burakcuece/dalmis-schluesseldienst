---
import LegalLayout from '../layouts/LegalLayout.astro';
import { business } from '../data/site';
import { mainNavigation } from '../data/navigation';
import { url } from '../lib/url';
---

<LegalLayout title="Seite nicht gefunden" description="Diese Seite wurde nicht gefunden." path="404/">
  <h1>Diese Seite gibt es nicht</h1>
  <p>Vielleicht hilft Ihnen eine dieser Seiten weiter:</p>
  <ul>
    {mainNavigation.map((item) => <li><a href={url(item.path)}>{item.label}</a></li>)}
  </ul>
  <p>Oder rufen Sie direkt an: <a href={business.phone.href}>{business.phone.display}</a></p>
  <a class="button button-primary" href={url()}>Zur Startseite</a>
</LegalLayout>
