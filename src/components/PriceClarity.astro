---
import Icon from './Icon.astro';
import { business } from '../data/site';
import { url } from '../lib/url';

interface Props {
  /** Link auf die Preisseite anzeigen (nicht auf der Preisseite selbst) */
  showPriceLink?: boolean;
}

const { showPriceLink = true } = Astro.props;
---

<section class="section section-light prices-section" id="preise">
  <div class="container price-clarity reveal">
    <div>
      <p class="eyebrow">Preistransparenz</p>
      <h2>Erst besprechen.<br />Dann beauftragen.</h2>
    </div>
    <div class="price-clarity-details">
      <p>
        Eine zugefallene Tür ist anders als eine abgeschlossene. Auch Schloss, Material, Uhrzeit und Aufwand beeinflussen die
        Kosten. Deshalb stimmen wir den voraussichtlichen Preis und das Vorgehen vor Beginn mit Ihnen ab.
      </p>
      <div class="price-clarity-actions">
        <a class="button button-primary" href={business.phone.href}><Icon name="phone" />Preis einschätzen lassen</a>
        {showPriceLink && <a class="text-link" href={url('preise/')}>So entsteht der Preis <span aria-hidden="true">→</span></a>}
      </div>
    </div>
  </div>
</section>
