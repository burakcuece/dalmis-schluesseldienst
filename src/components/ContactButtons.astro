---
/**
 * Anruf- und WhatsApp-Button als Paar.
 * `hero`: heller Hintergrund, `dark`: dunkler Hintergrund (Abschluss-CTA).
 * Beschriftung ist auf allen Seiten gleich: „Anrufen“ und „WhatsApp schreiben“.
 */
import Icon from './Icon.astro';
import { business, whatsappUrl } from '../data/site';

interface Props {
  variant?: 'hero' | 'dark';
  whatsappText?: string;
  class?: string;
}

const { variant = 'hero', whatsappText, class: className } = Astro.props;
const isHero = variant === 'hero';
---

<div class={className}>
  <a class="button button-primary button-large" href={business.phone.href}>
    <Icon name="phone" />
    <span><small>{business.phone.display}</small>Anrufen</span>
  </a>
  <a class:list={['button button-large', isHero ? 'button-light' : 'button-outline-light']} href={whatsappUrl(whatsappText)} target="_blank" rel="noopener noreferrer">
    <Icon name="whatsapp" />
    <span><small>Standort senden</small>WhatsApp schreiben</span>
  </a>
</div>
