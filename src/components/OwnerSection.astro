---
import Icon from './Icon.astro';
import { business, mailtoUrl } from '../data/site';
import { asset, url } from '../lib/url';

interface Props {
  showMoreLink?: boolean;
}

const { showMoreLink = true } = Astro.props;
---

<section class="section owner-section" id="ueber-uns">
  <div class="container owner-grid">
    <figure class="owner-photo reveal">
      <img src={asset('service-euro-cylinder.webp')} width="900" height="600" alt="Beispielmotiv: Hände messen einen Schließzylinder aus" loading="lazy" decoding="async" />
      <figcaption>Beispielmotiv · Arbeit am Schließzylinder</figcaption>
    </figure>
    <div class="owner-copy reveal">
      <p class="eyebrow">Ihr Ansprechpartner</p>
      <h2>{business.owner}. Persönlich für Sie da.</h2>
      <p class="feature-lead">
        {business.shortName} ist inhabergeführt. Bei Ihrer Anfrage sprechen Sie direkt mit {business.owner}, nicht mit einem anonymen Vermittlungsportal.
      </p>
      <p>Er kümmert sich um Anfragen zu Türen, Fahrzeugen und Sicherheitstechnik in {business.city} und Umgebung.</p>
      <div class="owner-contact">
        <a href={business.phone.href}><Icon name="phone" /><span><small>Direkt anrufen</small>{business.phone.display}</span></a>
        <a href={mailtoUrl}><Icon name="mail" /><span><small>E-Mail</small>{business.email}</span></a>
      </div>
      {showMoreLink && <a class="text-link" href={url('ueber-uns/')}>Mehr über {business.shortName} <span aria-hidden="true">→</span></a>}
    </div>
  </div>
</section>
