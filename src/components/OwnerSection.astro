---
/** Wer hinter DALMIS steht (Seite „Über uns“). Kontaktdaten stehen im Kontakt-Abschnitt darunter. */
import { business } from '../data/site';

interface Props {
  /** Hintergrund des Bereichs */
  tone?: 'white' | 'light';
}

const { tone = 'light' } = Astro.props;
---

<section class={`section section-${tone} owner-section`} id="ueber-uns">
  <div class="container owner-grid">
    <div class="owner-person">
      <h2>Ihr Schlüsseldienst im Revier</h2>
      <p class="owner-name"><strong>{business.owner}</strong>Inhaber, {business.city}</p>
    </div>
    <div class="owner-copy">
      <p class="feature-lead">
        Wir öffnen Türen und Fahrzeuge, tauschen Schlösser und Zylinder und beraten Sie zu Sicherheitstechnik.
      </p>
      <p>
        Mobil unterwegs in {business.city} und rund {business.radiusKm} Kilometer Umgebung. Den Preis nennen wir Ihnen am Telefon, bevor wir
        losfahren. Erst mit Ihrer Zusage ist der Einsatz vereinbart.
      </p>
    </div>
  </div>
</section>
