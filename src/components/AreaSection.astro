---
import Icon from './Icon.astro';
import { business, whatsappUrl } from '../data/site';
import { url } from '../lib/url';

interface Props {
  showMoreLink?: boolean;
}

const { showMoreLink = true } = Astro.props;
---

<section class="section section-dark area-section" id="einsatzgebiet">
  <div class="container area-grid">
    <div class="area-copy">
      <h2>Von {business.city} aus unterwegs</h2>
      <p class="feature-lead">
        {business.shortName} ist ein mobiler Schlüsseldienst mit Firmensitz in {business.city}. Sie nennen Ihren Standort, wir klären mit Ihnen, ob und wann ein Einsatz möglich ist.
      </p>
      <p>
        Je nach Auftrag ist {business.shortName} ungefähr {business.radiusKm} Kilometer rund um {business.city} unterwegs. Anfragen aus angrenzenden Teilen des
        Ruhrgebiets, des Ennepe-Ruhr-Kreises und des Münsterlands sind nach Rücksprache möglich.
      </p>
      <div class="area-links">
        <a class="button button-primary" href={whatsappUrl()} target="_blank" rel="noopener noreferrer">
          <Icon name="whatsapp" />
          Standort per WhatsApp senden
        </a>
        {showMoreLink && <a class="text-link" href={url('einsatzgebiet/')}>Mehr zum Einsatzgebiet</a>}
      </div>
    </div>
    <div class="area-places">
      <ul aria-label="Orte, aus denen Anfragen kommen">
        {business.places.map((place) => (place === business.city ? <li class="area-home">{place}<small>Firmensitz</small></li> : <li>{place}</li>))}
      </ul>
      <p>und Umgebung. Die Verfügbarkeit für Ihren Ort klären wir individuell.</p>
    </div>
  </div>
</section>
