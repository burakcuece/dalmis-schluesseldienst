---
/**
 * Einsatzgebiet mit schematischer Karte. Positionen in Kilometern relativ zu
 * Herten (x = Osten, y = Süden), berechnet aus echten Koordinaten.
 * Eigenes SVG statt Kartendienst: keine Verbindung zu Dritten (DSGVO).
 */
import Icon from './Icon.astro';
import { business, whatsappUrl } from '../data/site';
import { url } from '../lib/url';

interface Props {
  showMoreLink?: boolean;
}

const { showMoreLink = true } = Astro.props;

type Anchor = 'start' | 'end' | 'middle';

/** Orte, aus denen Anfragen typischerweise kommen (siehe business.places) */
const places: { name: string; x: number; y: number; anchor: Anchor; dx?: number; dy?: number }[] = [
  { name: 'Westerholt', x: -3.5, y: -0.5, anchor: 'end' },
  { name: 'Recklinghausen', x: 4.0, y: -2.1, anchor: 'start' },
  { name: 'Marl', x: -3.5, y: -6.8, anchor: 'end' },
  { name: 'Gelsenkirchen', x: -3.8, y: 8.6, anchor: 'end' },
  { name: 'Dorsten', x: -12.1, y: -7.2, anchor: 'end' },
];

/** Größere Städte nur zur Orientierung, grau dargestellt */
const landmarks: { name: string; x: number; y: number; anchor: Anchor }[] = [
  { name: 'Haltern am See', x: 3.1, y: -16.4, anchor: 'start' },
  { name: 'Bochum', x: 5.3, y: 12.5, anchor: 'start' },
  { name: 'Essen', x: -8.9, y: 15.4, anchor: 'end' },
  { name: 'Dortmund', x: 22.5, y: 9.0, anchor: 'start' },
];

const r = business.radiusKm;
const gap = (anchor: Anchor) => (anchor === 'start' ? 1.6 : anchor === 'end' ? -1.6 : 0);
---

<section class="section section-dark area-section" id="einsatzgebiet">
  <div class="container area-grid">
    <div class="area-copy">
      <h2>Einsatzgebiet: {`${r}\u00a0km`} rund um {business.city}</h2>
      <p class="feature-lead">
        Von unserem Firmensitz in {business.city} fahren wir je nach Auftrag bis etwa {r} Kilometer weit. Ihr Ort liegt knapp
        außerhalb? Fragen Sie trotzdem.
      </p>
      <div class="area-links">
        <a class="button button-primary button-large" href={business.phone.href}>
          <Icon name="phone" />
          <span><small>{business.phone.display}</small>Anrufen</span>
        </a>
        <a class="text-link" href={whatsappUrl()} target="_blank" rel="noopener noreferrer">Standort per WhatsApp senden</a>
      </div>
      {showMoreLink && <p class="area-more"><a class="text-link" href={url('einsatzgebiet/')}>Mehr zum Einsatzgebiet</a></p>}
    </div>

    <figure class="area-map">
      <svg viewBox="-38 -38 76 76" role="img" aria-labelledby="area-map-title">
        <title id="area-map-title">
          Karte: Einsatzgebiet {r} Kilometer rund um {business.city}, unter anderem {business.places.filter((p) => p !== business.city).join(', ')}
        </title>
        <circle class="map-ring-faint" r="10" />
        <circle class="map-ring-faint" r="20" />
        <circle class="map-area" r={r} />
        <text class="map-radius" x="0" y={-r - 1.2} text-anchor="middle">{r} km</text>

        {landmarks.map((l) => (
          <g class="map-landmark">
            <circle cx={l.x} cy={l.y} r="0.6" />
            <text x={l.x + gap(l.anchor)} y={l.y + 0.8} text-anchor={l.anchor}>{l.name}</text>
          </g>
        ))}

        {places.map((p) => (
          <g class="map-place">
            <circle cx={p.x} cy={p.y} r="0.9" />
            <text x={p.x + gap(p.anchor)} y={p.y + 0.95} text-anchor={p.anchor}>{p.name}</text>
          </g>
        ))}

        <g class="map-home">
          <circle r="2.4" class="map-home-halo" />
          <circle r="1.3" />
          <text x="0" y="5" text-anchor="middle">{business.city}</text>
        </g>
      </svg>
      <figcaption>Schematische Darstellung. Graue Orte dienen nur der Orientierung.</figcaption>
    </figure>
  </div>
</section>
