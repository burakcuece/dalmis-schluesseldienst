---
import Icon from './Icon.astro';
import { business, whatsappUrl } from '../data/site';
import { asset, url } from '../lib/url';

interface Props {
  showMoreLink?: boolean;
}

const { showMoreLink = true } = Astro.props;
---

<section class="section section-dark area-section" id="einsatzgebiet">
  <div class="container area-grid">
    <div class="area-copy reveal">
      <p class="eyebrow">Mobiler Service · Einsatzgebiet</p>
      <h2>Aus {business.city}. Direkt zu Ihnen.</h2>
      <p class="feature-lead">
        {business.shortName} ist ein mobiler Schlüsseldienst mit Firmensitz in {business.city}. Sie nennen Ihren Standort; {business.owner} klärt mit Ihnen, ob und wann ein Einsatz möglich ist.
      </p>
      <p>
        Je nach Auftrag ist {business.shortName} ungefähr {business.radiusKm} Kilometer rund um {business.city} unterwegs. Anfragen aus angrenzenden Teilen des
        Ruhrgebiets, des Ennepe-Ruhr-Kreises und des Münsterlands sind nach Rücksprache möglich.
      </p>
      <ul class="location-tags" aria-label="Beispiele für Anfragen aus der Umgebung">
        {business.places.map((place) => <li>{place}</li>)}
      </ul>
      <p class="area-note">Die Verfügbarkeit für Ihren Ort klären wir individuell.</p>
      <div class="area-links">
        <a class="button button-primary" href={whatsappUrl()} target="_blank" rel="noopener noreferrer">
          <Icon name="whatsapp" />
          Standort per WhatsApp senden
        </a>
        {showMoreLink && <a class="text-link" href={url('einsatzgebiet/')}>Mehr zum Einsatzgebiet <span aria-hidden="true">→</span></a>}
      </div>
    </div>
    <figure class="area-photo reveal">
      <img src={asset('mobile-tools.webp')} width="1200" height="800" alt="Beispielmotiv mit Werkzeug und Schließzylindern" loading="lazy" decoding="async" />
      <figcaption><strong>Mobiler Service</strong><span>Beispielmotiv · Schließtechnik und Werkzeug</span></figcaption>
    </figure>
  </div>
</section>
