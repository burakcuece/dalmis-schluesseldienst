---
/** Belegbare Fakten direkt unter dem Hero. Keine unbestätigten Versprechen aufnehmen. */
import Icon from './Icon.astro';
import { business } from '../data/site';
import type { IconName } from '../lib/icons';

const facts: { icon: IconName; title: string; text: string }[] = [
  { icon: 'user', title: `${business.owner} persönlich`, text: 'Inhabergeführt, kein Callcenter' },
  { icon: 'euro', title: 'Preis vorher', text: 'Sie entscheiden vor Arbeitsbeginn' },
  { icon: 'pin', title: `Aus ${business.city}`, text: 'Firmensitz im Revier' },
  { icon: 'car', title: `Rund ${business.radiusKm} km`, text: `Einsatzgebiet um ${business.city}` },
];
---

<div class="trust-strip">
  <ul class="container">
    {facts.map((fact) => (
      <li>
        <Icon name={fact.icon} />
        <span><strong>{fact.title}</strong>{fact.text}</span>
      </li>
    ))}
  </ul>
</div>
