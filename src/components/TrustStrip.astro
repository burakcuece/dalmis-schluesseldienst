---
/** Belegbare Fakten direkt unter dem Hero. Keine unbestätigten Versprechen aufnehmen. */
import Icon from './Icon.astro';
import { business } from '../data/site';
import type { IconName } from '../lib/icons';

const facts: { icon: IconName; title: string; text: string }[] = [
  { icon: 'clock', title: 'Rund um die Uhr', text: 'Notdienst auch nachts und am Wochenende' },
  { icon: 'check', title: 'Preis vorab', text: 'Am Telefon, bevor wir losfahren' },
  { icon: 'pin', title: `Aus ${business.city}`, text: `Rund ${business.radiusKm} km Einsatzgebiet` },
  { icon: 'key', title: 'Tür, Auto, Schloss', text: 'Alles aus einer Hand' },
];
---

<div class="trust-strip">
  <ul class="container">
    {facts.map((fact) => (
      <li>
        <Icon name={fact.icon} />
        <span><strong>{fact.title}</strong>{fact.text}</span>
      </li>
    ))}
  </ul>
</div>
