---
interface Step {
  title: string;
  text: string;
}

interface Props {
  title?: string;
  steps?: Step[];
  id?: string;
  /** Hintergrund des Bereichs */
  tone?: 'white' | 'light';
}

const defaultSteps: Step[] = [
  { title: 'Anrufen oder schreiben', text: 'Per Telefon oder WhatsApp. Sagen Sie, wo Sie sind und was passiert ist.' },
  { title: 'Preis erfahren', text: 'Sie hören den voraussichtlichen Preis, bevor wir losfahren.' },
  { title: 'Entscheiden', text: 'Erst mit Ihrer Zusage wird der Einsatz fest vereinbart.' },
  { title: 'Hilfe vor Ort', text: 'Wir kommen zu Ihnen und erledigen die Arbeit.' },
];

const { title = 'So läuft ein Einsatz ab', steps = defaultSteps, id = 'ablauf', tone = 'white' } = Astro.props;
---

<section class={`section section-compact section-${tone} process-section`} id={id}>
  <div class="container">
    <div class="section-heading">
      <h2>{title}</h2>
    </div>
    <ol class="process-grid">
      {steps.map((step, index) => (
        <li class="process-card">
          <span class="step-number">{index + 1}</span>
          <h3>{step.title}</h3>
          <p>{step.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
