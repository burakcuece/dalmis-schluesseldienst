---
interface Step {
  title: string;
  text: string;
}

interface Props {
  title?: string;
  steps?: Step[];
  id?: string;
  /** Hintergrund des Bereichs */
  tone?: 'white' | 'light';
}

const defaultSteps: Step[] = [
  { title: 'Kontakt aufnehmen', text: 'Anrufen oder per WhatsApp schreiben.' },
  { title: 'Situation schildern', text: 'Standort und Anliegen kurz nennen.' },
  { title: 'Einsatz abstimmen', text: 'Verfügbarkeit und nächste Schritte gemeinsam klären.' },
  { title: 'Hilfe vor Ort', text: 'Der mobile Service kommt zu Ihrem Standort.' },
];

const { title = 'So läuft ein Einsatz ab', steps = defaultSteps, id = 'ablauf', tone = 'white' } = Astro.props;
---

<section class={`section section-compact section-${tone} process-section`} id={id}>
  <div class="container">
    <div class="section-heading">
      <h2>{title}</h2>
    </div>
    <ol class="process-grid">
      {steps.map((step, index) => (
        <li class="process-card">
          <span class="step-number">{index + 1}</span>
          <h3>{step.title}</h3>
          <p>{step.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
