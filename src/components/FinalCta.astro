---
import ContactButtons from './ContactButtons.astro';
import { business } from '../data/site';

interface Props {
  title?: string;
  text?: string;
  whatsappText?: string;
}

const {
  title = `${business.owner} anrufen`,
  text = 'Schildern Sie kurz Ihr Anliegen und senden Sie bei Bedarf Ihren Standort.',
  whatsappText,
} = Astro.props;
---

<section class="final-cta" id="kontakt">
  <div class="container final-cta-inner">
    <div>
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <ContactButtons variant="dark" class="final-cta-actions" whatsappText={whatsappText} />
  </div>
</section>
