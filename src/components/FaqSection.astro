---
import FaqAccordion from './FaqAccordion.astro';
import type { FaqEntry } from '../data/faq';
import { business } from '../data/site';
import { url } from '../lib/url';

interface Props {
  entries: FaqEntry[];
  title?: string;
  intro?: string;
  showAllLink?: boolean;
  class?: string;
}

const {
  entries,
  title = 'Häufige Fragen',
  intro = 'Die wichtigsten Antworten für Ihre Anfrage.',
  showAllLink = true,
  class: className = 'section-light',
} = Astro.props;
---

<section class:list={['section faq-section', className]} id="faq">
  <div class="container faq-grid">
    <div class="faq-intro">
      <h2>{title}</h2>
      <p>{intro}</p>
      <p class="faq-phone">Frage nicht dabei? Rufen Sie an: <a href={business.phone.href}>{business.phone.display}</a></p>
      {showAllLink && (
        <p class="faq-more"><a class="text-link" href={url('faq/')}>Alle Fragen ansehen</a></p>
      )}
    </div>
    <FaqAccordion entries={entries} />
  </div>
</section>
