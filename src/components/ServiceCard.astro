---
import type { Service } from '../data/services';
import { servicePath } from '../data/services';
import { asset, url } from '../lib/url';

interface Props {
  service: Service;
  variant?: 'default' | 'featured' | 'compact';
  /** Überschriftenebene passend zur Seitenstruktur */
  headingLevel?: 'h2' | 'h3';
  id?: string;
}

const { service, variant = 'default', headingLevel = 'h3', id } = Astro.props;
const Heading = headingLevel;
---

<article
  class:list={['service-card reveal', { 'service-card-featured': variant === 'featured', 'service-card-compact': variant === 'compact' }]}
  id={id}
>
  <div class="service-card-media">
    <img src={asset(service.image)} width="900" height="600" alt={service.imageAlt} loading="lazy" decoding="async" />
  </div>
  <div class="service-card-content">
    <Heading>{service.title}</Heading>
    <p>{service.teaser}</p>
    <a href={url(servicePath(service.slug))}>Mehr erfahren<span class="visually-hidden"> zu {service.title}</span> <span aria-hidden="true">→</span></a>
  </div>
</article>
