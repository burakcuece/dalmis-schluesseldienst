---
/**
 * „Was ist passiert?“: Jede Kachel öffnet WhatsApp mit einer fertigen
 * Nachricht zur Situation. Besucher ergänzen nur noch den Standort.
 */
import Icon from './Icon.astro';
import { business, whatsappUrl } from '../data/site';
import type { IconName } from '../lib/icons';

const options: { icon: IconName; label: string; text: string }[] = [
  {
    icon: 'door',
    label: 'Tür zugefallen',
    text: 'Hallo Herr Dalmis, meine Tür ist zugefallen (nicht abgeschlossen). Es ist eine (Wohnungstür / Haustür). Mein Standort ist …',
  },
  {
    icon: 'lock',
    label: 'Tür abgeschlossen, Schlüssel weg',
    text: 'Hallo Herr Dalmis, meine Tür ist abgeschlossen und ich habe keinen Schlüssel. Es ist eine (Wohnungstür / Haustür). Mein Standort ist …',
  },
  {
    icon: 'car',
    label: 'Schlüssel im Auto',
    text: 'Hallo Herr Dalmis, ich komme nicht mehr in mein Fahrzeug. Marke und Modell: … Baujahr: … Mein Standort ist …',
  },
  {
    icon: 'key',
    label: 'Schloss defekt oder Schlüssel abgebrochen',
    text: 'Hallo Herr Dalmis, mein Schloss ist defekt bzw. der Schlüssel ist abgebrochen. Ein Foto schicke ich mit. Mein Standort ist …',
  },
];
---

<section class="section section-light quick-help" aria-labelledby="quick-help-title">
  <div class="container">
    <div class="quick-head">
      <h2 id="quick-help-title">Was ist passiert?</h2>
      <p>
        Tippen Sie auf Ihre Situation. WhatsApp öffnet sich mit einer fertigen Nachricht an uns, Sie ergänzen nur noch Ihren Standort.
      </p>
    </div>
    <ul class="quick-grid">
      {options.map((option) => (
        <li>
          <a class="quick-option" href={whatsappUrl(option.text)} target="_blank" rel="noopener noreferrer">
            <span class="quick-icon"><Icon name={option.icon} /></span>
            <strong>{option.label}</strong>
            <span class="quick-action"><Icon name="whatsapp" />WhatsApp öffnen</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="quick-alt">Lieber sprechen? <a href={business.phone.href}>{business.phone.display} anrufen</a></p>
  </div>
</section>
