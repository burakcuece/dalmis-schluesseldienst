---
/**
 * Gemeinsamer Rahmen für die Leistungsseiten.
 * Seitenkopf, Preisblock, FAQ, weitere Leistungen und Abschluss-CTA sind fest,
 * der eigentliche Inhalt kommt über den Slot.
 */
import BaseLayout from './BaseLayout.astro';
import FaqSection from '../components/FaqSection.astro';
import FinalCta from '../components/FinalCta.astro';
import PageHero from '../components/PageHero.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { getFaqs } from '../data/faq';
import { getService, servicePath, services, type Service } from '../data/services';
import { faqSchema, serviceSchema, type Crumb } from '../lib/schema';

interface Props {
  slug: Service['slug'];
  /** Seitentitel für Suchmaschinen */
  metaTitle: string;
  description: string;
  heroTitle: string;
  lead: string;
  faqIds: string[];
  faqTitle: string;
}

const { slug, metaTitle, description, heroTitle, lead, faqIds, faqTitle } = Astro.props;
const service = getService(slug);
const path = servicePath(slug);
const entries = getFaqs(faqIds);
const related = services.filter((entry) => entry.slug !== slug);

const crumbs: Crumb[] = [
  { label: 'Start', path: '' },
  { label: 'Leistungen', path: 'leistungen/' },
  { label: service.title, path },
];
---

<BaseLayout
  title={metaTitle}
  description={description}
  path={path}
  crumbs={crumbs}
  schema={[serviceSchema(service.title, description, path), faqSchema(entries, path)]}
>
  <PageHero
    title={heroTitle}
    lead={lead}
    crumbs={crumbs}
    image={service.image}
    imageAlt={service.imageAlt}
    whatsappText={service.whatsappText}
  />

  <slot />

  <FaqSection class="section-white" entries={entries} title={faqTitle} intro="Antworten auf Fragen, die bei dieser Leistung häufig gestellt werden." />

  <section class="section section-light" aria-labelledby="weitere-leistungen">
    <div class="container">
      <div class="section-heading">
        <h2 id="weitere-leistungen">Weitere Leistungen</h2>
      </div>
      <div class="services-grid services-grid-3">
        {related.map((entry) => <ServiceCard service={entry} variant="compact" />)}
      </div>
    </div>
  </section>

  <FinalCta whatsappText={service.whatsappText} />
</BaseLayout>
